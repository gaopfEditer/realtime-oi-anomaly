const BOARD_KINDS = [
  { key: 'gainers_value', title: '▲ 涨幅榜 / 按金额 (%)', side: 'up', metric: 'pct', unit: '%' },
  { key: 'losers_value', title: '▼ 跌幅榜 / 按金额 (%)', side: 'down', metric: 'pct', unit: '%' },
