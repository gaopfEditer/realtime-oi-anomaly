{
  "name": "mercu-clone-full",
  "version": "1.0.0",
  "private": true,
  "description": "Local crypto OI anomaly monitor: Binance futures data, anomaly radar, hot boards, post-anomaly watchlist and entry plans",
  "scripts": {
    "setup": "npm install --prefix api && npm install --prefix frontend",
    "dev:api": "cross-env PORT=3101 npm run dev --prefix api",
    "dev:frontend": "cross-env NEXT_PUBLIC_API_URL=http://localhost:3101 npm run dev --prefix frontend",
    "verify": "node scripts/verify.js",
    "test:watch": "node scripts/test-watchlist.js",
    "backtest:fetch": "python scripts/backtest/fetch_history.py",
    "backtest:repair": "python scripts/backtest/repair_cache.py",
    "backtest:replay": "node scripts/backtest/replay.js",
    "backtest:replay:optimized": "cross-env BT_PROFILE=optimized node scripts/backtest/replay.js",
    "dev:frontend:alt": "cross-env NEXT_PUBLIC_API_URL=http://localhost:3101 npm run dev:alt --prefix frontend",
    "backtest:optimize": "node scripts/backtest/optimize.js",
    "backtest:validate": "node scripts/backtest/validate.js",
    "backtest:replay:volume": "cross-env BT_PROFILE=volume node scripts/backtest/replay.js",
    "backtest:replay:rr": "cross-env BT_PROFILE=rr node scripts/backtest/replay.js",
    "backtest:period": "node scripts/backtest/period-breakdown.js",
    "backtest:morphology": "node scripts/backtest/morphology.js",
    "backtest:morphology:validate": "node scripts/backtest/morphology-validate.js",
    "backtest:morphology:windows": "node scripts/backtest/morphology-windows.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "keywords": [
    "crypto",
    "monitor",
    "market"
  ],
  "license": "MIT"
}
